{
  "name": "pdref-frontend",
  "version": "2.0.0-l4",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "cross-env API_ORIGIN=http://localhost:5080 ng serve --port 4200",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:coverage": "ng test --watch=false --coverage",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "serve:ssr": "node dist/PDREF_FRONTEND/server/server.mjs",
    "e2e": "playwright test",
    "e2e:axe": "playwright test e2e/design-system.spec.ts",
    "lighthouse": "lhci autorun",
    "check:budgets": "node scripts/check-budgets.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:build-warnings": "node scripts/check-build-warnings.mjs",
    "check:coverage": "node scripts/check-coverage.mjs",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run check:coverage && npm run check:build-warnings && npm run check:budgets && npm run check:tokens && npm run check:architecture"
  },
  "dependencies": {
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/platform-server": "21.2.25",
    "@angular/router": "21.2.25",
    "@angular/service-worker": "21.2.25",
    "@angular/ssr": "21.2.25",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "compression": "^1.8.2",
    "express": "5.1.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "21.4.0",
    "@angular-eslint/eslint-plugin": "21.4.0",
    "@angular-eslint/eslint-plugin-template": "21.4.0",
    "@angular-eslint/template-parser": "21.4.0",
    "@angular/build": "21.2.25",
    "@angular/cli": "21.2.25",
    "@angular/compiler-cli": "21.2.25",
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@types/compression": "^1.8.1",
    "@types/express": "5.0.1",
    "@types/node": "20.17.19",
    "@vitest/coverage-v8": "4.0.18",
    "angular-eslint": "21.4.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "27.1.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.0.18"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "packageManager": "npm@11.6.2"
}
